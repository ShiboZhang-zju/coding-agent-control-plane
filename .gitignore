# PoC sandbox repositories and runtime artifacts (never committed)
sandbox/*
!sandbox/.gitkeep
!sandbox/README.md

# Raw runtime logs / transcripts that may contain machine-specific paths or secrets
evidence/**/raw/
evidence/**/*.raw.log
evidence/environment/*serve*.log
evidence/environment/*serve*.log.*

# Control-plane local state / detached test logs (machine specific)
.poc-state/

# Local credentials (never committed)
.env
.env.*
*.pem
*.key
.poc-secrets.json

# Python / Node
__pycache__/
*.pyc
.venv/
node_modules/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
